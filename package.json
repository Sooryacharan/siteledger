{
  "name": "siteledger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 43123 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 43123 -H 0.0.0.0",
    "lint": "next lint",
    "db:validate": "prisma validate && prisma format --check",
    "test": "node --import tsx --test src/lib/money/formulas.test.ts src/lib/money/share.test.ts src/lib/gst/gstin.test.ts src/lib/integrity/hash.test.ts src/lib/identity/normalize.test.ts src/lib/area/variance.test.ts src/server/permissions.test.ts src/server/approval-rules.test.ts src/server/period-rules.test.ts src/server/chain.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test --test-concurrency=1 src/server/access.integration.test.ts src/server/projects.integration.test.ts",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "check:docs": "node scripts/check-mermaid.mjs",
    "check:schema": "node scripts/check-schema-coverage.mjs",
    "check": "npm run db:validate && npm test && npm run check:docs && npm run check:schema"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "10.5.0",
    "next": "14.2.35",
    "tailwind-merge": "^2.6.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^26.1.0",
    "mermaid": "^11.12.0",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
