# Local only. Copy to .env. Prisma validate reads DATABASE_URL and does not connect.
# These passwords are local placeholders, the same ones docker-compose.yml creates.
DATABASE_URL="postgresql://siteledger:siteledger@localhost:5432/siteledger?schema=public"
APP_DATABASE_URL="postgresql://siteledger_app:siteledger_app@localhost:5432/siteledger?schema=public"
# When true, the sign-in page shows the one-time token. Turn this off outside a local machine.
AUTH_EXPOSE_SIGNIN_TOKEN="true"
