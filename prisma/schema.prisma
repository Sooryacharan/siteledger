  leadId            String?       @map("lead_id") @db.Uuid
  salesOwnerId      String        @map("sales_owner_id") @db.Uuid
  bookingNumber     String        @map("booking_number")
  bookedOn          DateTime      @map("booked_on") @db.Date
  status            BookingStatus @default(TOKEN)
  baseValuePaise    BigInt        @map("base_value_paise")
  gstRateId         String?       @map("gst_rate_id") @db.Uuid
  supplyType        SupplyType    @map("supply_type")
  cgstPaise         BigInt        @default(0) @map("cgst_paise")
  sgstPaise         BigInt        @default(0) @map("sgst_paise")
  igstPaise         BigInt        @default(0) @map("igst_paise")
  cessPaise         BigInt        @default(0) @map("cess_paise")
  chargesPaise      BigInt        @default(0) @map("charges_paise")
  chargesGstPaise   BigInt        @default(0) @map("charges_gst_paise")
  totalPayablePaise BigInt        @map("total_payable_paise")
  notes             String?
  rowVersion        Int           @default(1) @map("row_version")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  createdById       String?       @map("created_by_id") @db.Uuid
  updatedById       String?       @map("updated_by_id") @db.Uuid

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unit             Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  lead             Lead?                @relation(fields: [leadId], references: [id], onDelete: Restrict)
  salesOwner       User                 @relation(fields: [salesOwnerId], references: [id], onDelete: Restrict)
  gstRate          GstRate?             @relation(fields: [gstRateId], references: [id], onDelete: Restrict)
  customers        BookingCustomer[]
  charges          BookingCharge[]
  agreements       Agreement[]
  cancellation     BookingCancellation?
  transfersOut     BookingTransfer[]    @relation("TransferFromBooking")
  transfersIn      BookingTransfer[]    @relation("TransferToBooking")
