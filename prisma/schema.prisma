  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  agreement    ProfitSharingAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  computedBy   User                   @relation(fields: [computedById], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?          @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  entries      ShareLedgerEntry[]

  @@index([projectId, computedAt], map: "share_computations_project_idx")
  @@map("share_computations")
}

/// Append-only partner ledger. Current profit share is the latest non-superseded computation, not the sum of every run.
model ShareLedgerEntry {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  partnerPartyId String         @map("partner_party_id") @db.Uuid
  computationId  String?        @map("computation_id") @db.Uuid
  entryType      ShareEntryType @map("entry_type")
  entryDate      DateTime       @map("entry_date") @db.Date
  amountPaise    BigInt         @map("amount_paise")
  narration      String
  sequence       Int
  prevHash       String         @map("prev_hash")
  entryHash      String         @map("entry_hash")
  createdAt      DateTime       @default(now()) @map("created_at")
  createdById    String?        @map("created_by_id") @db.Uuid

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  partner      Party             @relation(fields: [partnerPartyId], references: [id], onDelete: Restrict)
  computation  ShareComputation? @relation(fields: [computationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sequence], map: "share_ledger_org_seq")
  @@index([projectId, partnerPartyId], map: "share_ledger_partner_idx")
  @@map("share_ledger_entries")
}

