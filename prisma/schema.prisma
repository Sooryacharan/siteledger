// SiteLedger data model. Step 1 of the product spec in docs/SPEC.md.
//
// Money: every rupee amount is integer paise (BigInt). ₹1 = 100 paise.
// Rates are rupees as Decimal(18, 4). Areas are sqft as Decimal(14, 3).
// Percents are human percents: 18.0000 means 18%, stored as Decimal(8, 4).
//
// Tenancy: every business table has organization_id. PostgreSQL RLS uses it.
// Users, auth sessions, GST slabs, and TDS sections are global.
//
// Deletes: mutable rows use deleted_at. Posted money, stock, share ledgers,
// audit events, approval actions, area revisions, and period-lock events
// are append-only. Corrections are new rows (reversals), not updates.
//
// Hash columns are lowercase hex SHA-256. The canonical payloads live in
// src/lib/integrity/hash.ts. Genesis prev_hash is 64 zeros.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

