  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  phoneE164     String?   @map("phone_e164")
  locale        Locale    @default(EN)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  accounts               Account[]
  approvalActions        ApprovalAction[]
  approvalRequests       ApprovalRequest[]
  areaRevisions          UnitAreaRevision[]
  assignedLeads          Lead[]
  attendanceRecorded     LabourAttendance[]
  auditEvents            AuditEvent[]
  customerStatements     CustomerStatement[]
  devices                Device[]
  documentsUploaded      Document[]
  exceptionsAcknowledged ExceptionItem[]       @relation("ExceptionAcknowledger")
  exceptionsResolved     ExceptionItem[]       @relation("ExceptionResolver")
  followupsAssigned      LeadFollowup[]
  goodsReceiptsReceived  GoodsReceipt[]
  importBatches          ImportBatch[]
  indentsRequested       Indent[]
  interestAccruals       InterestAccrual[]
  journalsPosted         JournalEntry[]
  leadActivities         LeadActivity[]
  loanInterestAccruals   LoanInterestAccrual[]
  materialIssues         MaterialIssue[]
  measurementsChecked    MeasurementEntry[]    @relation("CheckedBy")
  measurementsTaken      MeasurementEntry[]    @relation("MeasuredBy")
  memberships            Membership[]
  notifications          Notification[]
  paymentsPrepared       Payment[]
  periodLockEvents       PeriodLockEvent[]
  periodsLocked          AccountingPeriod[]
  progressUpdates        ProgressUpdate[]
  projectAssignments     ProjectAssignment[]
  quoteComparisons       QuoteComparison[]
  receiptsRecorded       Receipt[]
  reconciliations        ReconciliationMatch[]
  salesBookings          Booking[]
  sessions               Session[]
  shareComputations      ShareComputation[]
  siteVisits             SiteVisit[]
  statementImports       BankStatementImport[]
  threeWayMatches        ThreeWayMatch[]

  @@map("users")
}

/// Auth.js account. Field names match the Prisma adapter.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

/// Org role. VENDOR and CUSTOMER must set partyId; staff roles must not.
/// OWNER may set partyId only as a shortcut to "my partner ledger". It does
/// not restrict what that owner can see.
model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole
  partyId        String?        @map("party_id") @db.Uuid
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  createdById    String?        @map("created_by_id") @db.Uuid
  updatedById    String?        @map("updated_by_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  party        Party?       @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId], map: "memberships_org_user_idx")
  @@index([partyId], map: "memberships_party_idx")
  @@map("memberships")
}

/// Project scope for PROJECT_MANAGER, SITE_ENGINEER, and SALES.
/// Those roles see only assigned projects. OWNER, FINANCE, and AUDITOR do not consult this table.
model ProjectAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")
  createdById    String?   @map("created_by_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([organizationId], map: "project_assignments_org_idx")
  @@index([userId], map: "project_assignments_user_idx")
  @@index([projectId], map: "project_assignments_project_idx")
  @@map("project_assignments")
}

model Device {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  label          String
  platform       DevicePlatform
  lastSeenAt     DateTime?      @map("last_seen_at")
  revokedAt      DateTime?      @map("revoked_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  syncMutations SyncMutation[]

  @@index([organizationId, userId], map: "devices_org_user_idx")
  @@map("devices")
}

// ---------------------------------------------------------------------------
// Audit, hash-chain heads, approvals, periods
// ---------------------------------------------------------------------------

/// Append-only. No updated_at and no deleted_at. The AUDIT chain covers these rows.
model AuditEvent {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  actorId        String?     @map("actor_id") @db.Uuid
  action         AuditAction
  entityType     RecordRef   @map("entity_type")
  entityId       String?     @map("entity_id") @db.Uuid
  occurredAt     DateTime    @default(now()) @map("occurred_at")
  before         Json?
  after          Json?
  requestId      String?     @map("request_id")
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent")
  deviceId       String?     @map("device_id") @db.Uuid
  sequence       Int
  prevHash       String      @map("prev_hash")
  eventHash      String      @map("event_hash")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sequence], map: "audit_events_org_seq")
  @@index([organizationId, entityType, entityId], map: "audit_events_entity_idx")
  @@index([actorId], map: "audit_events_actor_idx")
  @@map("audit_events")
}

/// One row per organization per chain. Moved forward only inside the posting transaction.
model ChainHead {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  chain          ChainName
  lastHash       String    @map("last_hash")
  lastSequence   Int       @default(0) @map("last_sequence")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, chain], map: "chain_heads_org_chain")
  @@map("chain_heads")
}

/// Amount bands and steps. autoApprove may be used only below a threshold the firm sets.
/// Period reopen is not configurable: the service requires an OWNER action. See docs.
model ApprovalPolicy {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  entityType     ApprovalEntity  @map("entity_type")
  minAmountPaise BigInt          @default(0) @map("min_amount_paise")
  maxAmountPaise BigInt?         @map("max_amount_paise")
  stepOrder      Int             @map("step_order")
  approverRole   MembershipRole? @map("approver_role")
  autoApprove    Boolean         @default(false) @map("auto_approve")
  plainLanguage  String          @map("plain_language")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  createdById    String?         @map("created_by_id") @db.Uuid
  updatedById    String?         @map("updated_by_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, entityType], map: "approval_policies_org_entity_idx")
  @@map("approval_policies")
}

model ApprovalRequest {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  entityType     ApprovalEntity @map("entity_type")
  entityId       String         @map("entity_id") @db.Uuid
  amountPaise    BigInt?        @map("amount_paise")
  status         ApprovalStatus @default(PENDING)
  currentStep    Int            @default(1) @map("current_step")
  requestedById  String         @map("requested_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  completedAt    DateTime?      @map("completed_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy          User                  @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  actions              ApprovalAction[]
  payments             Payment[]
  vendorInvoices       VendorInvoice[]
  raBills              RaBill[]
  workOrders           WorkOrder[]
  purchaseOrders       PurchaseOrder[]
  bookingCancellations BookingCancellation[]
  bookingTransfers     BookingTransfer[]
  periodLockEvents     PeriodLockEvent[]
  stockLedgerEntries   StockLedgerEntry[]

  @@index([organizationId, entityType, entityId], map: "approval_requests_entity_idx")
  @@index([requestedById], map: "approval_requests_requester_idx")
  @@map("approval_requests")
}

/// Append-only decision. actorId is null only for an auto-approve step.
model ApprovalAction {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  requestId      String           @map("request_id") @db.Uuid
  stepOrder      Int              @map("step_order")
  actorId        String?          @map("actor_id") @db.Uuid
  decision       ApprovalDecision
  comment        String?
  actedAt        DateTime         @default(now()) @map("acted_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  request      ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor        User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId], map: "approval_actions_request_idx")
  @@map("approval_actions")
}

model FiscalYear {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  startsOn       DateTime         @map("starts_on") @db.Date
  endsOn         DateTime         @map("ends_on") @db.Date
  status         FiscalYearStatus @default(OPEN)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  periods      AccountingPeriod[]
  sequences    DocumentSequence[]

  @@unique([organizationId, name], map: "fiscal_years_org_name")
  @@map("fiscal_years")
}

model AccountingPeriod {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  fiscalYearId   String       @map("fiscal_year_id") @db.Uuid
  name           String
  startsOn       DateTime     @map("starts_on") @db.Date
  endsOn         DateTime     @map("ends_on") @db.Date
  status         PeriodStatus @default(OPEN)
  lockedAt       DateTime?    @map("locked_at")
  lockedById     String?      @map("locked_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear   FiscalYear        @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  lockedBy     User?             @relation(fields: [lockedById], references: [id], onDelete: Restrict)
  journals     JournalEntry[]
  lockEvents   PeriodLockEvent[]

  @@unique([organizationId, startsOn], map: "accounting_periods_org_start")
  @@index([fiscalYearId], map: "accounting_periods_fy_idx")
  @@map("accounting_periods")
}

/// Append-only history of closes and reopens. REOPEN requires an owner-approved request.
model PeriodLockEvent {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  periodId          String           @map("period_id") @db.Uuid
  action            PeriodLockAction
  reason            String
  actorId           String           @map("actor_id") @db.Uuid
  approvalRequestId String?          @map("approval_request_id") @db.Uuid
  occurredAt        DateTime         @default(now()) @map("occurred_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  period          AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  actor           User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)

  @@index([periodId], map: "period_lock_events_period_idx")
  @@map("period_lock_events")
}

/// Statutory GST slabs. Global, not tenant data. Documents snapshot the percents they used.
model GstRate {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  cgstPercent   Decimal   @map("cgst_percent") @db.Decimal(8, 4)
  sgstPercent   Decimal   @map("sgst_percent") @db.Decimal(8, 4)
  igstPercent   Decimal   @map("igst_percent") @db.Decimal(8, 4)
  cessPercent   Decimal   @default(0) @map("cess_percent") @db.Decimal(8, 4)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")

  bookings           Booking[]
  demandNotes        DemandNote[]
  materials          Material[]
  purchaseOrderLines PurchaseOrderLine[]
  vendorInvoiceLines VendorInvoiceLine[]
  vendorQuoteLines   VendorQuoteLine[]

  @@map("gst_rates")
}

/// Statutory TDS sections. A vendor may carry a lower-deduction override.
model TdsSection {
  id             String  @id @default(uuid()) @db.Uuid
  code           String  @unique
  description    String
  ratePercent    Decimal @map("rate_percent") @db.Decimal(8, 4)
  thresholdPaise BigInt? @map("threshold_paise")
  isActive       Boolean @default(true) @map("is_active")

  vendorProfiles VendorProfile[]
  vendorInvoices VendorInvoice[]
  workOrders     WorkOrder[]
  raBills        RaBill[]

  @@map("tds_sections")
}

model DocumentSequence {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  fiscalYearId   String @map("fiscal_year_id") @db.Uuid
  docType        String @map("doc_type")
  prefix         String
  nextNumber     Int    @default(1) @map("next_number")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([organizationId, docType, fiscalYearId], map: "document_sequences_org_type_fy")
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Parties: customers, vendors, contractors, partners, lenders
// ---------------------------------------------------------------------------

/// One legal person. The same party can be a vendor and a partner.
/// PAN and GSTIN are stored so duplicate detection and TDS returns can run.
/// Aadhaar numbers are not stored. KYC scans are Documents.
model Party {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  kind               PartyKind
  legalName          String    @map("legal_name")
  displayName        String    @map("display_name")
  pan                String?
  panNormalized      String?   @map("pan_normalized")
  panShapeValid      Boolean?  @map("pan_shape_valid")
  gstin              String?
  gstinNormalized    String?   @map("gstin_normalized")
  gstinChecksumValid Boolean?  @map("gstin_checksum_valid")
  gstinValidatedAt   DateTime? @map("gstin_validated_at")
  isCustomer         Boolean   @default(false) @map("is_customer")
  isVendor           Boolean   @default(false) @map("is_vendor")
  isContractor       Boolean   @default(false) @map("is_contractor")
  isPartner          Boolean   @default(false) @map("is_partner")
  isLender           Boolean   @default(false) @map("is_lender")
  isRelatedParty     Boolean   @default(false) @map("is_related_party")
  relatedToPartyId   String?   @map("related_to_party_id") @db.Uuid
  relatedPartyNote   String?   @map("related_party_note")
  rowVersion         Int       @default(1) @map("row_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  createdById        String?   @map("created_by_id") @db.Uuid
  updatedById        String?   @map("updated_by_id") @db.Uuid

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  relatedToParty       Party?                @relation("PartyRelatedTo", fields: [relatedToPartyId], references: [id], onDelete: Restrict)
  relatedParties       Party[]               @relation("PartyRelatedTo")
  addresses            PartyAddress[]
  bankAccounts         PartyBankAccount[]
  contacts             PartyContact[]
  vendorProfile        VendorProfile?
  contractorProfile    ContractorProfile?
  memberships          Membership[]
  bookingCustomers     BookingCustomer[]
  transfersFrom        BookingTransfer[]     @relation("TransferFromParty")
  transfersTo          BookingTransfer[]     @relation("TransferToParty")
  receipts             Receipt[]
  capitalContributions CapitalContribution[]
  profitSharingRules   ProfitSharingRule[]
  unitAllocations      UnitAllocation[]
  shareLedgerEntries   ShareLedgerEntry[]
  vendorQuotes         VendorQuote[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  vendorInvoices       VendorInvoice[]
  workers              Worker[]
  workOrders           WorkOrder[]
  retentionEntries     RetentionEntry[]
  contractorAdvances   ContractorAdvance[]
  loansAsLender        Loan[]
  payments             Payment[]
  journalLines         JournalLine[]

  @@index([organizationId, panNormalized], map: "parties_org_pan_idx")
  @@index([organizationId, gstinNormalized], map: "parties_org_gstin_idx")
  @@index([organizationId, displayName], map: "parties_org_name_idx")
  @@map("parties")
}

model PartyAddress {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  partyId        String    @map("party_id") @db.Uuid
  line1          String    @map("line_1")
  line2          String?   @map("line_2")
  city           String
  stateCode      String    @map("state_code")
  pincode        String
  isPrimary      Boolean   @default(false) @map("is_primary")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([partyId], map: "party_addresses_party_idx")
  @@map("party_addresses")
}

/// Bank account used both to pay a vendor and to detect duplicates.
/// fingerprint is sha256(uppercase IFSC + "|" + digits-only account number).
model PartyBankAccount {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  partyId        String    @map("party_id") @db.Uuid
  bankName       String    @map("bank_name")
  accountHolder  String    @map("account_holder")
  accountNumber  String    @map("account_number")
  ifsc           String
  fingerprint    String
  isPrimary      Boolean   @default(false) @map("is_primary")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([organizationId, fingerprint], map: "party_bank_accounts_fingerprint_idx")
  @@index([partyId], map: "party_bank_accounts_party_idx")
  @@map("party_bank_accounts")
}

/// phone_e164 is the duplicate-detection key, compared inside one organization.
model PartyContact {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  partyId        String    @map("party_id") @db.Uuid
  name           String?
  phoneE164      String?   @map("phone_e164")
  email          String?
  isPrimary      Boolean   @default(false) @map("is_primary")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([organizationId, phoneE164], map: "party_contacts_org_phone_idx")
  @@index([partyId], map: "party_contacts_party_idx")
  @@map("party_contacts")
}

model VendorProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  partyId                String    @unique @map("party_id") @db.Uuid
  kycStatus              KycStatus @default(PENDING) @map("kyc_status")
  udyamNumber            String?   @map("udyam_number")
  tdsSectionId           String?   @map("tds_section_id") @db.Uuid
  tdsRateOverridePercent Decimal?  @map("tds_rate_override_percent") @db.Decimal(8, 4)
  notes                  String?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  tdsSection   TdsSection?  @relation(fields: [tdsSectionId], references: [id], onDelete: Restrict)

  @@index([organizationId], map: "vendor_profiles_org_idx")
  @@map("vendor_profiles")
}

model ContractorProfile {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  partyId                 String    @unique @map("party_id") @db.Uuid
  licenseNumber           String?   @map("license_number")
  pfEstablishmentCode     String?   @map("pf_establishment_code")
  esiCode                 String?   @map("esi_code")
  defaultRetentionPercent Decimal   @default(5) @map("default_retention_percent") @db.Decimal(8, 4)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@map("contractor_profiles")
}

// ---------------------------------------------------------------------------
// Projects, phases, towers, floors, units
// ---------------------------------------------------------------------------

model Project {
  id                       String        @id @default(uuid()) @db.Uuid
  organizationId           String        @map("organization_id") @db.Uuid
  code                     String
  name                     String
  status                   ProjectStatus @default(PLANNING)
  addressLine              String?       @map("address_line")
  city                     String?
  stateCode                String        @map("state_code")
  pincode                  String?
  reraRegistrationNumber   String?       @map("rera_registration_number")
  reraStateCode            String?       @map("rera_state_code")
  reraValidFrom            DateTime?     @map("rera_valid_from") @db.Date
  reraValidUntil           DateTime?     @map("rera_valid_until") @db.Date
  gstin                    String?
  gstinChecksumValid       Boolean?      @map("gstin_checksum_valid")
  costAreaBasis            CostAreaBasis @default(SUPER_BUILT_UP) @map("cost_area_basis")
  areaVarianceAlertPercent Decimal       @default(2) @map("area_variance_alert_percent") @db.Decimal(8, 4)
  wastageAlertPercent      Decimal       @default(2) @map("wastage_alert_percent") @db.Decimal(8, 4)
  startsOn                 DateTime?     @map("starts_on") @db.Date
  plannedEndsOn            DateTime?     @map("planned_ends_on") @db.Date
  rowVersion               Int           @default(1) @map("row_version")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  deletedAt                DateTime?     @map("deleted_at")
  createdById              String?       @map("created_by_id") @db.Uuid
  updatedById              String?       @map("updated_by_id") @db.Uuid

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments             ProjectAssignment[]
  unitAreaRevisions       UnitAreaRevision[]
  advanceRecoveries       AdvanceRecovery[]
  phases                  ProjectPhase[]
  towers                  Tower[]
  floors                  Floor[]
  units                   Unit[]
  costCentres             CostCentre[]
  boqItems                BoqItem[]
  leads                   Lead[]
  siteVisits              SiteVisit[]
  bookings                Booking[]
  agreements              Agreement[]
  bookingCancellations    BookingCancellation[]
  bookingTransfers        BookingTransfer[]
  demandNotes             DemandNote[]
  demandScheduleItems     DemandScheduleItem[]
  interestRules           InterestRule[]
  interestAccruals        InterestAccrual[]
  receipts                Receipt[]
  customerStatements      CustomerStatement[]
  progressUpdates         ProgressUpdate[]
  capitalContributions    CapitalContribution[]
  profitSharingAgreements ProfitSharingAgreement[]
  profitSharingRules      ProfitSharingRule[]
  unitAllocations         UnitAllocation[]
  shareComputations       ShareComputation[]
  shareLedgerEntries      ShareLedgerEntry[]
  stores                  Store[]
  indents                 Indent[]
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  vendorInvoices          VendorInvoice[]
  stockLedgerEntries      StockLedgerEntry[]
  materialIssues          MaterialIssue[]
  labourAttendances       LabourAttendance[]
  workOrders              WorkOrder[]
  measurementEntries      MeasurementEntry[]
  raBills                 RaBill[]
  retentionEntries        RetentionEntry[]
  contractorAdvances      ContractorAdvance[]
  budgets                 Budget[]
  loans                   Loan[]
  payments                Payment[]
  journalLines            JournalLine[]
  exceptionItems          ExceptionItem[]

  @@unique([organizationId, code], map: "projects_org_code")
  @@index([organizationId, status], map: "projects_org_status_idx")
  @@map("projects")
}

model ProjectPhase {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  name           String
  sortOrder      Int       @map("sort_order")
  startsOn       DateTime? @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  towers          Tower[]
  progressUpdates ProgressUpdate[]

  @@unique([projectId, sortOrder], map: "project_phases_project_sort")
  @@index([organizationId], map: "project_phases_org_idx")
  @@map("project_phases")
}

model Tower {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  phaseId        String?   @map("phase_id") @db.Uuid
  name           String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  phase           ProjectPhase?    @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  floors          Floor[]
  units           Unit[]
  progressUpdates ProgressUpdate[]

  @@unique([projectId, name], map: "towers_project_name")
  @@index([organizationId], map: "towers_org_idx")
  @@map("towers")
}

model Floor {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  towerId        String    @map("tower_id") @db.Uuid
  /// 0 is ground. Negative levels are basements.
  levelNumber    Int       @map("level_number")
  label          String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tower           Tower            @relation(fields: [towerId], references: [id], onDelete: Restrict)
  units           Unit[]
  progressUpdates ProgressUpdate[]

  @@unique([towerId, levelNumber], map: "floors_tower_level")
  @@index([organizationId], map: "floors_org_idx")
  @@map("floors")
}

/// Areas are sqft. Planned, approved, and built are stored together.
/// Every change also inserts a UnitAreaRevision. Current columns must match the latest revision.
model Unit {
  id                       String      @id @default(uuid()) @db.Uuid
  organizationId           String      @map("organization_id") @db.Uuid
  projectId                String      @map("project_id") @db.Uuid
  towerId                  String?     @map("tower_id") @db.Uuid
  floorId                  String?     @map("floor_id") @db.Uuid
  flatNumber               String      @map("flat_number")
  typology                 String?
  facing                   UnitFacing?
  status                   UnitStatus  @default(AVAILABLE)
  carpetPlannedSqft        Decimal     @default(0) @map("carpet_planned_sqft") @db.Decimal(14, 3)
  carpetApprovedSqft       Decimal     @default(0) @map("carpet_approved_sqft") @db.Decimal(14, 3)
  carpetBuiltSqft          Decimal     @default(0) @map("carpet_built_sqft") @db.Decimal(14, 3)
  builtUpPlannedSqft       Decimal     @default(0) @map("built_up_planned_sqft") @db.Decimal(14, 3)
  builtUpApprovedSqft      Decimal     @default(0) @map("built_up_approved_sqft") @db.Decimal(14, 3)
  builtUpBuiltSqft         Decimal     @default(0) @map("built_up_built_sqft") @db.Decimal(14, 3)
  superBuiltUpPlannedSqft  Decimal     @default(0) @map("super_built_up_planned_sqft") @db.Decimal(14, 3)
  superBuiltUpApprovedSqft Decimal     @default(0) @map("super_built_up_approved_sqft") @db.Decimal(14, 3)
  superBuiltUpBuiltSqft    Decimal     @default(0) @map("super_built_up_built_sqft") @db.Decimal(14, 3)
  rowVersion               Int         @default(1) @map("row_version")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")
  deletedAt                DateTime?   @map("deleted_at")
  createdById              String?     @map("created_by_id") @db.Uuid
  updatedById              String?     @map("updated_by_id") @db.Uuid

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tower            Tower?             @relation(fields: [towerId], references: [id], onDelete: Restrict)
  floor            Floor?             @relation(fields: [floorId], references: [id], onDelete: Restrict)
  areaRevisions    UnitAreaRevision[]
  bookings         Booking[]
  siteVisits       SiteVisit[]
  unitAllocations  UnitAllocation[]
  bookingTransfers BookingTransfer[]
