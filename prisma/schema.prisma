/// Commercial value is base + GST + charges. Schedule totals must equal totalPayablePaise.
/// totalPayablePaise is what the buyer owes before buyer-side TDS.
model Booking {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  projectId         String        @map("project_id") @db.Uuid
