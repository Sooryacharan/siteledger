model ShareComputation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  projectId      String            @map("project_id") @db.Uuid
  agreementId    String            @map("agreement_id") @db.Uuid
  computedById   String            @map("computed_by_id") @db.Uuid
  computedAt     DateTime          @default(now()) @map("computed_at")
  asOf           DateTime          @map("as_of") @db.Date
  profitPaise    BigInt            @map("profit_paise")
  formulaVersion String            @map("formula_version")
  status         ComputationStatus @default(POSTED)
  supersededAt   DateTime?         @map("superseded_at")
  journalEntryId String?           @unique @map("journal_entry_id") @db.Uuid
