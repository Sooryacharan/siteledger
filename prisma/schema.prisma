  demandNotes      DemandNote[]
  interestAccruals InterestAccrual[]
  receipts         Receipt[]
  statements       CustomerStatement[]

  @@unique([organizationId, bookingNumber], map: "bookings_org_number")
  @@index([projectId, status], map: "bookings_project_status_idx")
  @@index([unitId], map: "bookings_unit_idx")
  @@map("bookings")
}

