  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  costCentre         CostCentre?         @relation(fields: [costCentreId], references: [id], onDelete: Restrict)
  material           Material?           @relation(fields: [materialId], references: [id], onDelete: Restrict)
  indentLines        IndentLine[]
  materialIssueLines MaterialIssueLine[]
  workOrderLines     WorkOrderLine[]
  budgetLines        BudgetLine[]

  @@unique([projectId, code], map: "boq_items_project_code")
  @@index([organizationId], map: "boq_items_org_idx")
  @@map("boq_items")
}

