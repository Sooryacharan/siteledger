  code                    String
  description             String
  uom                     String
  normQty                 Decimal?  @map("norm_qty") @db.Decimal(18, 4)
  normQtyPerSqft          Decimal?  @map("norm_qty_per_sqft") @db.Decimal(18, 6)
  wastageAllowancePercent Decimal   @default(0) @map("wastage_allowance_percent") @db.Decimal(8, 4)
  estimatedRateRupees     Decimal?  @map("estimated_rate_rupees") @db.Decimal(18, 4)
