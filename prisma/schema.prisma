  principalPaise    BigInt   @map("principal_paise")
  annualRatePercent Decimal  @map("annual_rate_percent") @db.Decimal(8, 4)
  dayCount          Int      @map("day_count")
  amountPaise       BigInt   @map("amount_paise")
  formulaVersion    String   @default("interest.simple.actual365.v1") @map("formula_version")
  journalEntryId    String?  @unique @map("journal_entry_id") @db.Uuid
  reversalOfId      String?  @unique @map("reversal_of_id") @db.Uuid
  recordedById      String   @map("recorded_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  booking      Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  demandNote   DemandNote       @relation(fields: [demandNoteId], references: [id], onDelete: Restrict)
  rule         InterestRule     @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  reversalOf   InterestAccrual? @relation("InterestReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal     InterestAccrual? @relation("InterestReversal")
  recordedBy   User             @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([bookingId], map: "interest_accruals_booking_idx")
  @@map("interest_accruals")
}

/// amount_paise is cash received. buyer_tds_paise is TDS the buyer withheld (an entered fact, with a certificate attached).
model Receipt {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  projectId           String        @map("project_id") @db.Uuid
  bookingId           String        @map("booking_id") @db.Uuid
  payerPartyId        String?       @map("payer_party_id") @db.Uuid
  bankAccountId       String?       @map("bank_account_id") @db.Uuid
  recordedById        String        @map("recorded_by_id") @db.Uuid
  receiptNumber       String        @map("receipt_number")
  status              ReceiptStatus @default(DRAFT)
  receivedOn          DateTime      @map("received_on") @db.Date
  valueDate           DateTime?     @map("value_date") @db.Date
  channel             MoneyChannel
  instrumentReference String?       @map("instrument_reference")
  amountPaise         BigInt        @map("amount_paise")
  buyerTdsPaise       BigInt        @default(0) @map("buyer_tds_paise")
  narration           String?
  journalEntryId      String?       @unique @map("journal_entry_id") @db.Uuid
  clientMutationId    String?       @unique @map("client_mutation_id")
  rowVersion          Int           @default(1) @map("row_version")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")
  createdById         String?       @map("created_by_id") @db.Uuid

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  booking      Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payer        Party?              @relation(fields: [payerPartyId], references: [id], onDelete: Restrict)
  bankAccount  BankAccount?        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  recordedBy   User                @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  allocations  ReceiptAllocation[]

  @@unique([organizationId, receiptNumber], map: "receipts_org_number")
  @@index([bookingId], map: "receipts_booking_idx")
  @@index([instrumentReference], map: "receipts_reference_idx")
  @@map("receipts")
}

model ReceiptAllocation {
  id             String   @id @default(uuid()) @db.Uuid
