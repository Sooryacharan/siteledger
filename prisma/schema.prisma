/// BOQ norm. norm_qty_per_sqft is bags (or other UOM) per sqft of Project.costAreaBasis.
/// expected qty = area × norm_qty_per_sqft × (1 + wastage_allowance_percent / 100).
model BoqItem {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  projectId               String    @map("project_id") @db.Uuid
  costCentreId            String?   @map("cost_centre_id") @db.Uuid
