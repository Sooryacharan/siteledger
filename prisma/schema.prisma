  @@index([demandNoteId], map: "receipt_allocations_demand_idx")
  @@map("receipt_allocations")
}

/// Immutable snapshot of a statement that was issued. Live dues are computed, not stored here.
model CustomerStatement {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  bookingId      String   @map("booking_id") @db.Uuid
  issuedById     String   @map("issued_by_id") @db.Uuid
  issuedOn       DateTime @map("issued_on") @db.Date
  asOf           DateTime @map("as_of") @db.Date
  openingPaise   BigInt   @map("opening_paise")
  demandsPaise   BigInt   @map("demands_paise")
  interestPaise  BigInt   @map("interest_paise")
  receiptsPaise  BigInt   @map("receipts_paise")
  refundsPaise   BigInt   @map("refunds_paise")
