  feePaise       BigInt      @default(0) @map("fee_paise")
  createdAt      DateTime    @default(now()) @map("created_at")
  createdById    String?     @map("created_by_id") @db.Uuid

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  loan               Loan                @relation(fields: [loanId], references: [id], onDelete: Restrict)
  journalEntry       JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  emiLines           EmiScheduleLine[]
  paymentAllocations PaymentAllocation[]

  @@index([loanId, txnDate], map: "loan_transactions_loan_idx")
  @@map("loan_transactions")
}

model EmiSchedule {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  loanId              String            @map("loan_id") @db.Uuid
  version             Int
  generatedAt         DateTime          @default(now()) @map("generated_at")
  formulaVersion      String            @default("emi.reducing.monthly.v1") @map("formula_version")
  annualRatePercent   Decimal           @map("annual_rate_percent") @db.Decimal(8, 4)
  principalPaise      BigInt            @map("principal_paise")
  tenureMonths        Int               @map("tenure_months")
  contractualEmiPaise BigInt            @map("contractual_emi_paise")
  status              ComputationStatus @default(POSTED)
  supersededAt        DateTime?         @map("superseded_at")
  supersedesId        String?           @unique @map("supersedes_id") @db.Uuid

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  loan         Loan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  supersedes   EmiSchedule?      @relation("EmiScheduleVersion", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy EmiSchedule?      @relation("EmiScheduleVersion")
  lines        EmiScheduleLine[]

  @@unique([loanId, version], map: "emi_schedules_loan_version")
  @@map("emi_schedules")
}

model EmiScheduleLine {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  scheduleId            String    @map("schedule_id") @db.Uuid
  loanTransactionId     String?   @map("loan_transaction_id") @db.Uuid
  installmentNumber     Int       @map("installment_number")
  dueOn                 DateTime  @map("due_on") @db.Date
  openingPrincipalPaise BigInt    @map("opening_principal_paise")
  principalPaise        BigInt    @map("principal_paise")
  interestPaise         BigInt    @map("interest_paise")
  emiPaise              BigInt    @map("emi_paise")
  closingPrincipalPaise BigInt    @map("closing_principal_paise")
  status                EmiStatus @default(DUE)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  schedule        EmiSchedule      @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  loanTransaction LoanTransaction? @relation(fields: [loanTransactionId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, installmentNumber], map: "emi_lines_schedule_no")
  @@map("emi_schedule_lines")
}

/// Outbound money. APPROVED and PAID require an approval and at least one source document.
model Payment {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  projectId           String?        @map("project_id") @db.Uuid
  partyId             String         @map("party_id") @db.Uuid
  bankAccountId       String?        @map("bank_account_id") @db.Uuid
  preparedById        String         @map("prepared_by_id") @db.Uuid
  approvalRequestId   String?        @map("approval_request_id") @db.Uuid
  journalEntryId      String?        @unique @map("journal_entry_id") @db.Uuid
  purpose             PaymentPurpose
  status              PaymentStatus  @default(DRAFT)
  paymentDate         DateTime       @map("payment_date") @db.Date
  channel             MoneyChannel
  instrumentReference String?        @map("instrument_reference")
  amountPaise         BigInt         @map("amount_paise")
  narration           String?
  idempotencyKey      String?        @unique @map("idempotency_key")
  rowVersion          Int            @default(1) @map("row_version")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project         Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  party           Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  bankAccount     BankAccount?        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  preparedBy      User                @relation(fields: [preparedById], references: [id], onDelete: Restrict)
  approvalRequest ApprovalRequest?    @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  journalEntry    JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  allocations     PaymentAllocation[]
  sourceLinks     PaymentSourceLink[]

  @@index([organizationId, status], map: "payments_org_status_idx")
  @@index([partyId], map: "payments_party_idx")
  @@index([paymentDate], map: "payments_date_idx")
  @@map("payments")
}

/// Exactly one target is set. Enforced by a check constraint in prisma/sql/checks.sql.
model PaymentAllocation {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  paymentId             String   @map("payment_id") @db.Uuid
  amountPaise           BigInt   @map("amount_paise")
  vendorInvoiceId       String?  @map("vendor_invoice_id") @db.Uuid
  raBillId              String?  @map("ra_bill_id") @db.Uuid
  loanTransactionId     String?  @map("loan_transaction_id") @db.Uuid
  contractorAdvanceId   String?  @map("contractor_advance_id") @db.Uuid
  bookingCancellationId String?  @map("booking_cancellation_id") @db.Uuid
  retentionEntryId      String?  @map("retention_entry_id") @db.Uuid
  narration             String?
  createdAt             DateTime @default(now()) @map("created_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment             Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  vendorInvoice       VendorInvoice?       @relation(fields: [vendorInvoiceId], references: [id], onDelete: Restrict)
  raBill              RaBill?              @relation(fields: [raBillId], references: [id], onDelete: Restrict)
  loanTransaction     LoanTransaction?     @relation(fields: [loanTransactionId], references: [id], onDelete: Restrict)
  contractorAdvance   ContractorAdvance?   @relation(fields: [contractorAdvanceId], references: [id], onDelete: Restrict)
  bookingCancellation BookingCancellation? @relation(fields: [bookingCancellationId], references: [id], onDelete: Restrict)
  retentionEntry      RetentionEntry?      @relation(fields: [retentionEntryId], references: [id], onDelete: Restrict)

  @@index([paymentId], map: "payment_allocations_payment_idx")
  @@map("payment_allocations")
}

model PaymentSourceLink {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, documentId], map: "payment_source_links_payment_doc")
  @@map("payment_source_links")
}

model TallyLedgerMap {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  tallyLedgerName String @map("tally_ledger_name")
  glAccountId     String @map("gl_account_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  glAccount    GlAccount    @relation(fields: [glAccountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, tallyLedgerName], map: "tally_ledger_maps_org_name")
  @@map("tally_ledger_maps")
}

model ImportBatch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  createdById    String       @map("created_by_id") @db.Uuid
  documentId     String?      @map("document_id") @db.Uuid
  kind           ImportKind
  status         ImportStatus @default(PENDING)
  rowCount       Int          @default(0) @map("row_count")
  errorCount     Int          @default(0) @map("error_count")
  errorReport    Json?        @map("error_report")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy            User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  document             Document?             @relation(fields: [documentId], references: [id], onDelete: Restrict)
  bankStatementImports BankStatementImport[]

  @@index([organizationId, kind], map: "import_batches_org_kind_idx")
  @@map("import_batches")
}

// ---------------------------------------------------------------------------
// Documents, exceptions, notifications, sync, search
// ---------------------------------------------------------------------------

model Document {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  uploadedById   String    @map("uploaded_by_id") @db.Uuid
  entityType     RecordRef @map("entity_type")
  entityId       String    @map("entity_id") @db.Uuid
  fileName       String    @map("file_name")
  mimeType       String    @map("mime_type")
  byteSize       Int       @map("byte_size")
  storageKey     String    @map("storage_key")
  sha256         String
  ocrStatus      OcrStatus @default(PENDING) @map("ocr_status")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy           User                  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  ocrExtraction        OcrExtraction?
  paymentSourceLinks   PaymentSourceLink[]
  bankStatementImports BankStatementImport[]
  importBatches        ImportBatch[]

  @@index([organizationId, entityType, entityId], map: "documents_entity_idx")
  @@index([sha256], map: "documents_sha_idx")
  @@map("documents")
}

model OcrExtraction {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  documentId     String   @unique @map("document_id") @db.Uuid
  provider       String
  rawText        String?  @map("raw_text") @db.Text
  fields         Json?
  confidence     Decimal? @db.Decimal(5, 4)
  extractedAt    DateTime @default(now()) @map("extracted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@map("ocr_extractions")
}

model ExceptionRule {
  id                       String            @id @default(uuid()) @db.Uuid
  organizationId           String            @map("organization_id") @db.Uuid
  code                     ExceptionCode
  isEnabled                Boolean           @default(true) @map("is_enabled")
  severity                 ExceptionSeverity
  plainLanguage            String            @map("plain_language")
  roundFigureMultiplePaise BigInt?           @map("round_figure_multiple_paise")
  roundFigureMinPaise      BigInt?           @map("round_figure_min_paise")
  flagSaturday             Boolean           @default(true) @map("flag_saturday")
  flagSunday               Boolean           @default(true) @map("flag_sunday")
  areaVariancePercent      Decimal?          @map("area_variance_percent") @db.Decimal(8, 4)
  wastageVariancePercent   Decimal?          @map("wastage_variance_percent") @db.Decimal(8, 4)
  unmatchedAfterDays       Int?              @map("unmatched_after_days")
  approvalOverdueHours     Int?              @map("approval_overdue_hours")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        ExceptionItem[]

  @@unique([organizationId, code], map: "exception_rules_org_code")
  @@map("exception_rules")
}

model ExceptionItem {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  projectId         String?           @map("project_id") @db.Uuid
  ruleId            String?           @map("rule_id") @db.Uuid
  code              ExceptionCode
  severity          ExceptionSeverity
  status            ExceptionStatus   @default(OPEN)
  title             String
  detail            String?
  entityType        RecordRef         @map("entity_type")
  entityId          String            @map("entity_id") @db.Uuid
  relatedEntityType RecordRef?        @map("related_entity_type")
  relatedEntityId   String?           @map("related_entity_id") @db.Uuid
  matchedOn         String?           @map("matched_on")
  detectedAt        DateTime          @default(now()) @map("detected_at")
  acknowledgedById  String?           @map("acknowledged_by_id") @db.Uuid
  acknowledgedAt    DateTime?         @map("acknowledged_at")
  resolvedById      String?           @map("resolved_by_id") @db.Uuid
  resolvedAt        DateTime?         @map("resolved_at")
  resolutionNote    String?           @map("resolution_note")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rule           ExceptionRule? @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  acknowledgedBy User?          @relation("ExceptionAcknowledger", fields: [acknowledgedById], references: [id], onDelete: Restrict)
  resolvedBy     User?          @relation("ExceptionResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, code], map: "exception_items_org_status_idx")
  @@index([entityType, entityId], map: "exception_items_entity_idx")
  @@map("exception_items")
}

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  channel        NotificationChannel
  locale         Locale              @default(EN)
  templateKey    String              @map("template_key")
  payload        Json
  status         NotificationStatus  @default(QUEUED)
  error          String?
  scheduledFor   DateTime?           @map("scheduled_for")
  sentAt         DateTime?           @map("sent_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, status], map: "notifications_org_status_idx")
  @@map("notifications")
}

model SyncMutation {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  deviceId         String        @map("device_id") @db.Uuid
  clientMutationId String        @map("client_mutation_id")
  entityType       OfflineEntity @map("entity_type")
  entityId         String?       @map("entity_id") @db.Uuid
  payload          Json
  status           SyncStatus    @default(PENDING)
  rejectionReason  String?       @map("rejection_reason")
  receivedAt       DateTime      @default(now()) @map("received_at")
  appliedAt        DateTime?     @map("applied_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([deviceId, clientMutationId], map: "sync_mutations_device_client")
  @@index([organizationId, status], map: "sync_mutations_org_status_idx")
  @@map("sync_mutations")
}

/// Projection for Cmd-K. Rebuilt from the source rows. Not a financial record.
model SearchDocument {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  entityType     RecordRef @map("entity_type")
  entityId       String    @map("entity_id") @db.Uuid
  title          String
  subtitle       String?
  keywords       String
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, entityType, entityId], map: "search_documents_entity")
  @@index([organizationId, title], map: "search_documents_title_idx")
  @@map("search_documents")
}
